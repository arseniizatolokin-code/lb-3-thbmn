@startuml
skinparam shadowing false
skinparam componentStyle rectangle
actor "Замовник / виконавець" as U
actor "Арбітр / адмін" as A
component "Вебінтерфейс\n(HTML + ethers.js)" as UI
component "Гаманець\n(MetaMask)" as W
package "Позаланцюгова частина" {
  component "API (FastAPI)\n/score /predict /specs /decisions" as API
  component "ML-модель\nmodel.joblib (SHA-256)" as ML
  database "SQLite\nТЗ, профілі, рішення" as DB
  component "Сервіс-оракул (Node.js)\nповтори, журнал, ідемпотентність" as OR
  database "state.db\nоброблені події" as ST
}
package "Блокчейн (Hardhat / Sepolia)" {
  component "Escrow" as E
  component "RiskOracle\n(реєстр версій моделі)" as R
  component "ReputationSBT" as S
}
U --> UI
A --> UI
UI --> W : підпис транзакцій
W --> E
UI --> API : ТЗ, пояснення, цілісність
UI ..> R : читання подій (аудит)
API --> ML
API --> DB
OR --> E : слухає DealProposed
OR --> API : POST /score
OR --> R : submitRisk(ризик, версія, хеш)
OR --> ST
E --> R : getRisk, depositBps
E --> S : recordOutcome
@enduml
