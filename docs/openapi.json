    "required": [
     "deal_id",
     "spec_hash",
     "client",
     "freelancer",
     "amounts_eth",
     "due_days"
    ],
    "title": "ScoreIn"
   },
   "SpecIn": {
    "properties": {
     "text": {
      "type": "string",
      "maxLength": 20000,
      "minLength": 10,
      "title": "Text"
