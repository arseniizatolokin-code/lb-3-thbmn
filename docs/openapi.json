      "anyOf": [
       {
        "type": "number",
        "maximum": 1.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Freelancer Prev Dispute Rate"
     },
     "freelancer_avg_rating": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 5.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Freelancer Avg Rating"
