    "properties": {
     "deal_id": {
      "type": "integer",
      "minimum": 1.0,
      "title": "Deal Id"
     },
     "spec_hash": {
      "type": "string",
      "title": "Spec Hash"
     },
     "client": {
      "type": "string",
      "title": "Client"
     },
     "freelancer": {
      "type": "string",
      "title": "Freelancer"
     },
     "amounts_eth": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "maxItems": 10,
      "minItems": 1,
      "title": "Amounts Eth"
     },
     "due_days": {
      "items": {
       "type": "integer"
      },
      "type": "array",
      "maxItems": 10,
      "minItems": 1,
      "title": "Due Days"
     },
